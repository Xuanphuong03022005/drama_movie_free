[
  {
    "id": 1,
    "start": "00:00:02.944",
    "end": "00:00:04.944",
    "text": "Don't be scared."
  },
  {
    "id": 2,
    "start": "00:00:11.776",
    "end": "00:00:13.776",
    "text": "Help me!"
  },
  {
    "id": 3,
    "start": "00:00:13.776",
    "end": "00:00:15.776",
    "text": "Hight! The dragon!"
  },
  {
    "id": 4,
    "start": "00:00:14.720",
    "end": "00:00:17.220",
    "text": "The Tiger King's Ride is a hunting virgin again!"
  },
  {
    "id": 5,
    "start": "00:00:26.496",
    "end": "00:00:29.496",
    "text": "(crowd cheering)"
  },
  {
    "id": 6,
    "start": "00:00:29.440",
    "end": "00:00:32.440",
    "text": "[GUNFIRE]"
  },
  {
    "id": 7,
    "start": "00:00:38.272",
    "end": "00:00:42.272",
    "text": "useless not a single one"
  },
  {
    "id": 8,
    "start": "00:00:41.216",
    "end": "00:00:43.136",
    "text": "one can withstand the dragon breath."
  },
  {
    "id": 9,
    "start": "00:00:43.136",
    "end": "00:00:44.136",
    "text": "Execute them all."
  },
  {
    "id": 10,
    "start": "00:00:44.160",
    "end": "00:00:47.080",
    "text": "- Okay, okay, okay. (laughing)"
  },
  {
    "id": 11,
    "start": "00:00:47.104",
    "end": "00:00:50.104",
    "text": "Your majesty enough, I found her. The sacred blood."
  },
  {
    "id": 12,
    "start": "00:00:50.048",
    "end": "00:00:52.048",
    "text": "She will bear your dragon hair."
  },
  {
    "id": 13,
    "start": "00:00:52.992",
    "end": "00:00:54.992",
    "text": "Sacred blood indeed."
  },
  {
    "id": 14,
    "start": "00:00:55.936",
    "end": "00:00:58.656",
    "text": "Tonight you will breed me a dragon-a."
  },
  {
    "id": 15,
    "start": "00:00:58.880",
    "end": "00:01:00.880",
    "text": "Don't touch me."
  },
  {
    "id": 16,
    "start": "00:01:00.880",
    "end": "00:01:01.880",
    "text": "Can't even stand up."
  },
  {
    "id": 17,
    "start": "00:01:01.824",
    "end": "00:01:04.704",
    "text": "man's touch. How will you take my dragon fire?"
  },
  {
    "id": 18,
    "start": "00:01:04.768",
    "end": "00:01:07.648",
    "text": "Your majesty give me time. I'll have her ready"
  },
  {
    "id": 19,
    "start": "00:01:07.712",
    "end": "00:01:09.712",
    "text": "You have one day."
  },
  {
    "id": 20,
    "start": "00:01:10.656",
    "end": "00:01:11.856",
    "text": "Bring Lucius to me."
  },
  {
    "id": 21,
    "start": "00:01:13.600",
    "end": "00:01:16.600",
    "text": "You're just the cause of the hair's pattern."
  },
  {
    "id": 22,
    "start": "00:01:16.544",
    "end": "00:01:17.544",
    "text": "Time to come."
  },
  {
    "id": 23,
    "start": "00:01:34.208",
    "end": "00:01:36.208",
    "text": "Lucia's."
  },
  {
    "id": 24,
    "start": "00:01:37.152",
    "end": "00:01:39.152",
    "text": "My queen."
  },
  {
    "id": 25,
    "start": "00:01:40.096",
    "end": "00:01:45.096",
    "text": "One day teach the sacred blood to take"
  },
  {
    "id": 26,
    "start": "00:01:43.040",
    "end": "00:01:45.040",
    "text": "Dragonfire. Please, the King."
  },
  {
    "id": 27,
    "start": "00:01:48.928",
    "end": "00:01:51.808",
    "text": "baby and I'll send you to die right now."
  },
  {
    "id": 28,
    "start": "00:01:51.872",
    "end": "00:01:54.872",
    "text": "If the sacred blood dies, who else can the queen find?"
  },
  {
    "id": 29,
    "start": "00:01:57.760",
    "end": "00:02:00.480",
    "text": "From now on, the King's Woman is mine."
  },
  {
    "id": 30,
    "start": "00:02:00.704",
    "end": "00:02:03.464",
    "text": "Keep it from the king and don't break her."
  },
  {
    "id": 31,
    "start": "00:02:03.648",
    "end": "00:02:05.648",
    "text": "But more tonight."
  },
  {
    "id": 32,
    "start": "00:02:06.592",
    "end": "00:02:08.592",
    "text": "I would have taught her to please a dragon."
  }
]