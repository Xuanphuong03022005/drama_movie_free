[
  {
    "id": 1,
    "start": "00:00:00.000",
    "end": "00:00:03.000",
    "text": "[GUNFIRE]"
  },
  {
    "id": 2,
    "start": "00:00:02.944",
    "end": "00:00:03.944",
    "text": "Help!"
  },
  {
    "id": 3,
    "start": "00:00:03.944",
    "end": "00:00:04.944",
    "text": "Sigh!"
  },
  {
    "id": 4,
    "start": "00:00:05.888",
    "end": "00:00:07.888",
    "text": "[Grunts]"
  },
  {
    "id": 5,
    "start": "00:00:08.832",
    "end": "00:00:11.832",
    "text": "Hey, Laina! Stay on the way!"
  },
  {
    "id": 6,
    "start": "00:00:11.776",
    "end": "00:00:13.776",
    "text": "You have to stay alive!"
  },
  {
    "id": 7,
    "start": "00:00:14.720",
    "end": "00:00:16.720",
    "text": "WAAAHHHHH!"
  },
  {
    "id": 8,
    "start": "00:00:17.664",
    "end": "00:00:20.144",
    "text": "Come of age, marry your destined one!"
  },
  {
    "id": 9,
    "start": "00:00:20.608",
    "end": "00:00:22.608",
    "text": "- No! - No!"
  },
  {
    "id": 10,
    "start": "00:00:23.552",
    "end": "00:00:25.552",
    "text": "(laughing)"
  },
  {
    "id": 11,
    "start": "00:00:26.496",
    "end": "00:00:28.496",
    "text": "[GASP]"
  },
  {
    "id": 12,
    "start": "00:00:29.440",
    "end": "00:00:31.440",
    "text": "(gunshot)"
  },
  {
    "id": 13,
    "start": "00:00:32.384",
    "end": "00:00:35.384",
    "text": "Give me the sacred boobling!"
  },
  {
    "id": 14,
    "start": "00:00:35.328",
    "end": "00:00:36.328",
    "text": "No!"
  },
  {
    "id": 15,
    "start": "00:00:36.328",
    "end": "00:00:38.328",
    "text": "Your parents are dead."
  },
  {
    "id": 16,
    "start": "00:00:38.272",
    "end": "00:00:41.272",
    "text": "You're an orphan now. I'll raise you to marry Lucy"
  },
  {
    "id": 17,
    "start": "00:00:41.216",
    "end": "00:00:43.216",
    "text": "and you've got to be grateful."
  },
  {
    "id": 18,
    "start": "00:00:43.216",
    "end": "00:00:45.216",
    "text": "You do everything I do."
  },
  {
    "id": 19,
    "start": "00:00:44.160",
    "end": "00:00:46.660",
    "text": "Say from now on let go of me"
  },
  {
    "id": 20,
    "start": "00:00:47.104",
    "end": "00:00:48.104",
    "text": "My baby!"
  },
  {
    "id": 21,
    "start": "00:00:48.104",
    "end": "00:00:49.104",
    "text": "(laughs)"
  },
  {
    "id": 22,
    "start": "00:00:49.104",
    "end": "00:00:50.104",
    "text": "The Progenitor!"
  },
  {
    "id": 23,
    "start": "00:00:50.048",
    "end": "00:00:52.928",
    "text": "is eternal. All hail our king!"
  },
  {
    "id": 24,
    "start": "00:00:55.936",
    "end": "00:00:58.936",
    "text": "It's her, my destiny."
  },
  {
    "id": 25,
    "start": "00:00:58.880",
    "end": "00:01:01.880",
    "text": "I've waited 300 minutes."
  },
  {
    "id": 26,
    "start": "00:01:01.824",
    "end": "00:01:02.824",
    "text": "Yes."
  },
  {
    "id": 27,
    "start": "00:01:04.768",
    "end": "00:01:06.768",
    "text": "Strange."
  },
  {
    "id": 28,
    "start": "00:01:07.712",
    "end": "00:01:09.712",
    "text": "The sent just vanished."
  },
  {
    "id": 29,
    "start": "00:01:10.656",
    "end": "00:01:12.656",
    "text": "(laughing)"
  },
  {
    "id": 30,
    "start": "00:01:13.600",
    "end": "00:01:15.600",
    "text": "[BANG]"
  },
  {
    "id": 31,
    "start": "00:01:16.544",
    "end": "00:01:18.544",
    "text": "[GUNFIRE]"
  },
  {
    "id": 32,
    "start": "00:01:22.432",
    "end": "00:01:25.432",
    "text": "But it'd be that..."
  },
  {
    "id": 33,
    "start": "00:01:25.376",
    "end": "00:01:30.376",
    "text": "human child. When my destiny made"
  },
  {
    "id": 34,
    "start": "00:01:28.320",
    "end": "00:01:30.320",
    "text": "It comes of age."
  },
  {
    "id": 35,
    "start": "00:01:30.320",
    "end": "00:01:32.320",
    "text": "I'll know from you."
  },
  {
    "id": 36,
    "start": "00:01:31.264",
    "end": "00:01:32.264",
    "text": "for certain."
  },
  {
    "id": 37,
    "start": "00:01:37.152",
    "end": "00:01:39.912",
    "text": "(door creaking)"
  },
  {
    "id": 38,
    "start": "00:01:40.096",
    "end": "00:01:43.096",
    "text": "Elena are you blind?"
  },
  {
    "id": 39,
    "start": "00:01:43.040",
    "end": "00:01:45.040",
    "text": "You can't even do a simple chore right."
  },
  {
    "id": 40,
    "start": "00:01:45.984",
    "end": "00:01:47.984",
    "text": "Sorry, young master Lucy and I'll clean it up right now."
  },
  {
    "id": 41,
    "start": "00:01:48.928",
    "end": "00:01:50.928",
    "text": "Oh!"
  },
  {
    "id": 42,
    "start": "00:01:51.872",
    "end": "00:01:53.872",
    "text": "[coughing]"
  },
  {
    "id": 43,
    "start": "00:01:53.872",
    "end": "00:01:55.872",
    "text": "You think you're still..."
  },
  {
    "id": 44,
    "start": "00:01:54.816",
    "end": "00:01:56.816",
    "text": "So the Guildmaster's precious daughter."
  },
  {
    "id": 45,
    "start": "00:01:57.760",
    "end": "00:02:00.760",
    "text": "Vampires burn your whole family."
  },
  {
    "id": 46,
    "start": "00:02:00.704",
    "end": "00:02:03.504",
    "text": "If my father and I hadn't taken you in,"
  },
  {
    "id": 47,
    "start": "00:02:03.648",
    "end": "00:02:05.648",
    "text": "You'd have stopped to death!"
  },
  {
    "id": 48,
    "start": "00:02:09.536",
    "end": "00:02:11.536",
    "text": "[coughing]"
  },
  {
    "id": 49,
    "start": "00:02:12.480",
    "end": "00:02:15.080",
    "text": "How much longer must I endure this?"
  },
  {
    "id": 50,
    "start": "00:02:15.080",
    "end": "00:02:16.580",
    "text": "Where'd I go?"
  },
  {
    "id": 51,
    "start": "00:02:15.424",
    "end": "00:02:17.424",
    "text": "I'm a little bit ever end."
  },
  {
    "id": 52,
    "start": "00:02:18.368",
    "end": "00:02:28.368",
    "text": "When you come of age, they may be a little bit of a pain."
  },
  {
    "id": 53,
    "start": "00:02:21.312",
    "end": "00:02:24.312",
    "text": "and awaits you. The vampire."
  },
  {
    "id": 54,
    "start": "00:02:24.256",
    "end": "00:02:26.256",
    "text": "a progenitor is waiting for me."
  }
]