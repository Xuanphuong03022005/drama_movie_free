[
  {
    "id": 1,
    "start": "00:00:00.000",
    "end": "00:00:03.000",
    "text": "Do I have to tell Garvin the bad news?"
  },
  {
    "id": 2,
    "start": "00:00:02.944",
    "end": "00:00:04.944",
    "text": "on his birthday."
  },
  {
    "id": 3,
    "start": "00:00:05.888",
    "end": "00:00:08.728",
    "text": "Are you out of your mind? You want half a million?"
  },
  {
    "id": 4,
    "start": "00:00:08.832",
    "end": "00:00:11.332",
    "text": "My boyfriend's project needs investment."
  },
  {
    "id": 5,
    "start": "00:00:11.776",
    "end": "00:00:14.776",
    "text": "The 500,000 is the inheritance my mother left me."
  },
  {
    "id": 6,
    "start": "00:00:17.664",
    "end": "00:00:20.664",
    "text": "Your money has already been spent by me."
  },
  {
    "id": 7,
    "start": "00:00:20.608",
    "end": "00:00:23.448",
    "text": "(water running)"
  },
  {
    "id": 8,
    "start": "00:00:23.552",
    "end": "00:00:26.552",
    "text": "Not even a penny you shall receive. Now get lost."
  },
  {
    "id": 9,
    "start": "00:00:32.384",
    "end": "00:00:35.384",
    "text": ">> Mr. Rodriguez has been"
  },
  {
    "id": 10,
    "start": "00:00:35.328",
    "end": "00:00:37.328",
    "text": "anticipating you."
  },
  {
    "id": 11,
    "start": "00:00:44.160",
    "end": "00:00:46.900",
    "text": "(typing)"
  },
  {
    "id": 12,
    "start": "00:00:47.104",
    "end": "00:00:47.944",
    "text": "Bye-bye."
  },
  {
    "id": 13,
    "start": "00:00:52.992",
    "end": "00:00:55.792",
    "text": "You're late. I'll spank you."
  }
]