[
  {
    "id": 1,
    "start": "00:00:00.000",
    "end": "00:00:02.000",
    "text": "Please help me."
  },
  {
    "id": 2,
    "start": "00:00:02.944",
    "end": "00:00:05.944",
    "text": "[SIGH]"
  },
  {
    "id": 3,
    "start": "00:00:05.888",
    "end": "00:00:07.888",
    "text": "Do you know what you're doing?"
  },
  {
    "id": 4,
    "start": "00:00:08.832",
    "end": "00:00:11.832",
    "text": "Teach me how to make a drug."
  },
  {
    "id": 5,
    "start": "00:00:11.776",
    "end": "00:00:13.096",
    "text": "and obsessed with me."
  },
  {
    "id": 6,
    "start": "00:00:14.720",
    "end": "00:00:16.720",
    "text": "What's in it for me?"
  },
  {
    "id": 7,
    "start": "00:00:17.664",
    "end": "00:00:19.664",
    "text": "Haven't you saved me enough times already?"
  },
  {
    "id": 8,
    "start": "00:00:20.608",
    "end": "00:00:23.408",
    "text": "And now you're not like the rest of them."
  },
  {
    "id": 9,
    "start": "00:00:23.552",
    "end": "00:00:25.552",
    "text": "[sighs]"
  },
  {
    "id": 10,
    "start": "00:00:26.496",
    "end": "00:00:29.496",
    "text": "My rules, I say stop. You stop."
  },
  {
    "id": 11,
    "start": "00:00:29.440",
    "end": "00:00:33.440",
    "text": "up. If the king finds out where"
  },
  {
    "id": 12,
    "start": "00:00:32.384",
    "end": "00:00:34.384",
    "text": "I'm gonna fuck that."
  },
  {
    "id": 13,
    "start": "00:00:35.328",
    "end": "00:00:37.328",
    "text": "I want to die."
  },
  {
    "id": 14,
    "start": "00:00:37.328",
    "end": "00:00:38.328",
    "text": "Lesson one."
  },
  {
    "id": 15,
    "start": "00:00:38.272",
    "end": "00:00:40.672",
    "text": "Don't treat it dragon like a man."
  },
  {
    "id": 16,
    "start": "00:00:41.216",
    "end": "00:00:44.216",
    "text": "I'm more than..."
  },
  {
    "id": 17,
    "start": "00:00:44.160",
    "end": "00:00:46.440",
    "text": "like a fire that God control itself."
  },
  {
    "id": 18,
    "start": "00:00:47.104",
    "end": "00:00:49.104",
    "text": "Let it come close."
  },
  {
    "id": 19,
    "start": "00:00:50.048",
    "end": "00:00:52.048",
    "text": "But don't let it consume."
  },
  {
    "id": 20,
    "start": "00:00:52.048",
    "end": "00:00:53.048",
    "text": "Did I do it right?"
  },
  {
    "id": 21,
    "start": "00:00:55.936",
    "end": "00:00:57.936",
    "text": "How about this?"
  },
  {
    "id": 22,
    "start": "00:01:00.620",
    "end": "00:01:01.800",
    "text": "- You taught me to kiss there."
  },
  {
    "id": 23,
    "start": "00:01:01.824",
    "end": "00:01:03.824",
    "text": "I came up with it myself."
  },
  {
    "id": 24,
    "start": "00:01:03.824",
    "end": "00:01:05.824",
    "text": "You're playing with fire."
  },
  {
    "id": 25,
    "start": "00:01:04.768",
    "end": "00:01:07.768",
    "text": "And teach me how to get burned."
  },
  {
    "id": 26,
    "start": "00:01:10.656",
    "end": "00:01:11.936",
    "text": "Don't fuck with me like that."
  },
  {
    "id": 27,
    "start": "00:01:11.936",
    "end": "00:01:12.936",
    "text": "No shit."
  }
]